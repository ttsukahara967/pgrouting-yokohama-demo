<?xml version="1.0" encoding="UTF-8"?>
<!--
  Car profile for osm2pgrouting, tuned for urban Japan.
  Based on the bundled mapconfig_for_cars.xml, whose defaults are European
  (e.g. 90 km/h on tertiary roads), which makes city-center ETAs far too short.

  maxspeed (km/h) is used only when a way has no OSM maxspeed tag; tagged ways
  use their own limit. cost_s = length_m / speed, so these values are
  free-flow assumptions: no signals, turns or congestion.
  Highway types not listed here (footway, cycleway, steps, ...) are not imported.
-->
<configuration>
  <tag_name name="highway" id="1">
    <tag_value name="motorway"          id="101" priority="1.0"  maxspeed="80" />
    <tag_value name="motorway_link"     id="102" priority="1.0"  maxspeed="40" />
    <tag_value name="trunk"             id="104" priority="1.05" maxspeed="50" />
    <tag_value name="trunk_link"        id="105" priority="1.05" maxspeed="30" />
    <tag_value name="primary"           id="106" priority="1.15" maxspeed="40" />
    <tag_value name="primary_link"      id="107" priority="1.15" maxspeed="30" />
    <tag_value name="secondary"         id="108" priority="1.5"  maxspeed="40" />
    <tag_value name="secondary_link"    id="109" priority="1.5"  maxspeed="30" />
    <tag_value name="tertiary"          id="110" priority="1.75" maxspeed="30" />
    <tag_value name="tertiary_link"     id="111" priority="1.75" maxspeed="30" />
    <tag_value name="unclassified"      id="117" priority="3"    maxspeed="30" />
    <tag_value name="residential"       id="112" priority="2.5"  maxspeed="20" />
    <tag_value name="living_street"     id="113" priority="3"    maxspeed="10" />
    <tag_value name="service"           id="114" priority="2.5"  maxspeed="10" />
    <tag_value name="road"              id="100" priority="5"    maxspeed="20" />
  </tag_name>
</configuration>
