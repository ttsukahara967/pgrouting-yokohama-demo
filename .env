# Area to import: min_lon,min_lat,max_lon,max_lat (WGS84 / EPSG:4326).
# Default covers Yokohama Station, Minato Mirai, Kannai and Shin-Yokohama.
# Changing it triggers a re-import on the next `docker compose up`.
BBOX=139.58,35.42,139.68,35.53

# Source extract (Geofabrik). Downloaded once and cached in the osm_cache volume.
OSM_PBF_URL=https://download.geofabrik.de/asia/japan/kanto-latest.osm.pbf

# Host port for the web app.
WEB_PORT=8080
